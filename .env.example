# Copy to .env and adjust. Never commit .env.
POSTGRES_PASSWORD=change-me-in-real-deployments

# LLM provider: mock (default, no credentials) | ollama (local) | openai (any OpenAI-compatible endpoint) | anthropic
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# Cost estimates are only shown for real models if you set prices ($ per 1M tokens):
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Local Ollama (see docs/LOCAL_MODELS.md). Example for a 4 GB GPU / 8 GB RAM machine:
#   LLM_PROVIDER=ollama  LLM_MODEL=qwen2.5:3b
#   EMBEDDING_PROVIDER=ollama  EMBEDDING_MODEL=nomic-embed-text  EMBEDDING_DIM=768
#   EMBEDDING_QUERY_PREFIX="search_query: "  EMBEDDING_DOCUMENT_PREFIX="search_document: "
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings: hashing (offline, default) | ollama (local neural) | openai (OpenAI-compatible /embeddings)
# Changing the model/dimension on an existing DB: `alembic upgrade head` then `python -m app.reindex`.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Seeds demo tenants/users/documents on first start. DEMO_MODE exposes demo API keys on the login page.
# Set BOTH to false in any real deployment.
SEED_ON_START=true
DEMO_MODE=true

# Browser-visible API URL baked into the frontend image at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
